{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "description": "ReachInbox Email Scheduler - Production Backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "probe:send-path": "tsx src/tests/sendPathProbe.ts",
    "test:failure-injection": "tsx src/tests/failureInjection.ts",
    "test:outages": "tsx src/tests/dependencyOutage.ts",
    "test:security": "tsx src/tests/security.ts",
    "verify:xss-assertion": "tsx scripts/verifyXssAssertion.ts",
    "verify:recipient-binding": "tsx scripts/verifyRecipientBinding.ts",
    "check:slack": "tsx scripts/checkSlackConnection.ts",
    "load:test": "tsx src/tests/loadTest.ts",
    "test:invariants": "tsx src/tests/invariantTest.ts",
    "retention:sweep": "tsx -e \"import('./src/services/retention.js').then(m => m.runRetention().then(r => { console.log(r); process.exit(0); }))\"",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bull-board/express": "^6.7.10",
    "@elastic/elasticsearch": "^8.17.0",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
