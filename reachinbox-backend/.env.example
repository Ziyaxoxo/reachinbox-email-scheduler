# ---------------------------------------------------------------------------
# Secrets — never commit real values. Load these from your secret manager.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------

JWT_SECRET=replace-with-32-plus-random-characters-0000000
ENCRYPTION_KEY=replace-with-32-byte-base64-key-00000000000000=

# Operator token for the BullMQ dashboard (min 16 chars).
DASHBOARD_TOKEN=replace-with-long-random-operator-token
DASHBOARD_READ_ONLY=true

# Slack credentials must stay out of version control. Keep them in your
# untracked .env only.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
